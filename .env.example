# Live mode: point the server at your Vocabit backend.
VOCABIT_BASE_URL=https://your-vocabit-backend.example.com
VOCABIT_AGENT_KEY=generate-with-openssl-rand-hex-24

# Optional: act on behalf of a specific learner (Firebase UID).
# Omit to use the backend's AGENT_DEFAULT_USER_ID.
# VOCABIT_USER_ID=

# Optional: default languages for new sets.
# VOCABIT_TERM_LANGUAGE=de
# VOCABIT_DEFINITION_LANGUAGE=en

# Demo mode: no backend, no key, in-memory fixtures. Great for trying the server out.
# VOCABIT_DEMO=1
